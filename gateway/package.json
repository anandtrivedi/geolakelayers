{
  "name": "geolakelayers",
  "version": "0.1.0",
  "private": true,
  "description": "GeoLakeLayers: Unity Catalog tables as live map layers for Experience Builder and OGC clients, queried as each signed-in user (provider vendored from koop-provider-databricks @ a08f6e7)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "console:dev": "vite --config console/vite.config.ts",
    "console:build": "vite build --config console/vite.config.ts"
  },
  "dependencies": {
    "@databricks/sql": "1.12.0",
    "@koopjs/koop-core": "10.4.17",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "js-sql-parser": "1.6.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
